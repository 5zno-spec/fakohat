{
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://store.wqargroup.com"}, {"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/(index.html|manifest.webmanifest)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
    {"source": "/(icon-192.png|icon-512.png)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]}
  ]
}
